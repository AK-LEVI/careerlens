# Optional environment settings for the CareerLens API
# CAREERLENS_DB_PATH=C:\path\to\careerlens.db
# CAREERLENS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: store a read-only GitHub API token in the server environment, not in frontend code.
# GITHUB_TOKEN=
# Copy this file to .env and add your OpenAI API key to enable AI-written insights.
# The key stays on the backend; never add it to frontend files.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
